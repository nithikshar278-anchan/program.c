#include<stdio.h>
int main()
{
    int choice;
    do
    {
        printf("1:insert\n");
        printf("2:delete\n");
        printf("3:peek\n");
        printf("4:display\n");
        printf("enter your choice\n");
        switch(choice)
        {
            case1:
            printf("insert");
            break;
            case2:
            printf("delete");
            break;
            case3:
            printf("peek");
            break;
            case4:
            printf("display");
            break;
            default:
            printf("no operation");
        }
    }
    while(choice<5 && choice>=1);
    return(0);
}
